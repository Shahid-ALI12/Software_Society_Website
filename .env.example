FIREBASE_SERVICE_ACCOUNT_JSON=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Manual alternative: UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
